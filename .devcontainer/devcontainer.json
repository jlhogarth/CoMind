{
  "name": "CoMind Codespace",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/CoMind",
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "forwardPorts": [
    3000,
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "CBE interactive browser",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "cd server && npm ci && cd .. && bash scripts/bootstrap_dev_runtime.sh",
  "postStartCommand": "bash scripts/cbe_codespace_autostart.sh",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "humao.rest-client"
      ]
    }
  }
}
