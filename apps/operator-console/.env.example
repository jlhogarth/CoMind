# Browser-safe configuration only. Use the project's publishable key, not a secret or service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Protected RuleBook operator controls are disabled unless this server-only mode is explicitly enabled.
# These values must exist only in the trusted server runtime. Never prefix them with NEXT_PUBLIC_.
OPERATOR_CONSOLE_RULEBOOK_ACCESS_MODE=disabled
SUPABASE_SECRET_KEY=
OPERATOR_CONSOLE_RULEBOOK_REVIEWER_ID=

# Continuous Excellence status is read-only and disabled unless this server-only mode is explicitly enabled.
# It reuses SUPABASE_SECRET_KEY only inside the trusted server runtime and never exposes CE base tables to browser roles.
OPERATOR_CONSOLE_CE_ACCESS_MODE=disabled

# Do not create NEXT_PUBLIC_* variables containing database passwords, secret keys, service-role keys,
# privileged reviewer identities, or other server-only capabilities.
