# Browser-safe configuration. Use the live project's URL and modern publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration. Never prefix these variables with NEXT_PUBLIC_.
# Use a modern sb_secret_ key, not the legacy service-role JWT.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Administrative execution remains fail-closed unless explicitly enabled.
OPERATOR_CONSOLE_ADMIN_ENABLED=false
OPERATOR_CONSOLE_ADMIN_TOKEN=

# Never create NEXT_PUBLIC_* variables containing database passwords, secret keys, admin tokens, or service-role keys.
